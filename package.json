  "type": "module",
  "bugs": {
    "url": "https://github.com/seki999/ai-bilingual-story-player/issues"
  },
  "homepage": "https://seki999.github.io/ai-bilingual-story-player/",
  "dependencies": {
    "dexie": "^4.4.7",
    "jszip": "^3.10.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
